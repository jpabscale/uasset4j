# Normalize line endings for text files across platforms (Linux/macOS/Windows).
* text=auto

# Explicit UTF-8 for source and docs.
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.cs    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.properties text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files must never be line-normalized.
*.jar   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.pak   binary
*.usmap binary
*.uasset binary
*.uexp   binary
*.umap  binary
*.7z    binary
*.gz    binary
*.zip   binary
*.png   binary
*.jpg   binary
*.ico   binary
